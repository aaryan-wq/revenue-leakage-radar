{
  "version": "2.3",
  "sections": [
    { "id": "profile", "label": "Your company", "estimated_seconds": 30 },
    { "id": "pricing", "label": "Pricing", "estimated_seconds": 25 },
    { "id": "usage", "label": "Usage pricing", "estimated_seconds": 15 },
    { "id": "seats", "label": "Per-seat billing", "estimated_seconds": 10 },
    { "id": "product", "label": "Products and plans", "estimated_seconds": 15 },
    { "id": "contracts", "label": "Contracts", "estimated_seconds": 20 },
    { "id": "discounts", "label": "Discounts", "estimated_seconds": 20 },
    { "id": "changes", "label": "Pricing history", "estimated_seconds": 15 },
    { "id": "systems", "label": "Billing systems", "estimated_seconds": 10 },
    { "id": "operations", "label": "Operations", "estimated_seconds": 15 },
    { "id": "quote_to_bill", "label": "Sales to billing", "estimated_seconds": 10 },
    { "id": "migrations", "label": "Migrations", "estimated_seconds": 10 },
    { "id": "international", "label": "International", "estimated_seconds": 10 },
    { "id": "controls", "label": "Billing checks", "estimated_seconds": 15 },
    { "id": "confidence", "label": "Final check", "estimated_seconds": 10 }
  ],
  "questions": [
    {
      "id": "profile.company_type",
      "section": "profile",
      "type": "select",
      "label": "What best describes your business?",
      "required": true,
      "options": [
        { "value": "b2b_saas", "label": "B2B SaaS" },
        { "value": "b2b_b2c", "label": "B2B + B2C" },
        { "value": "b2c_saas", "label": "B2C SaaS" },
        { "value": "marketplace", "label": "Marketplace" },
        { "value": "services_saas", "label": "Services + SaaS" },
        { "value": "other", "label": "Other" }
      ],
      "hypotheses": []
    },
    {
      "id": "profile.arr_amount",
      "section": "profile",
      "type": "currency",
      "label": "What is your annual recurring revenue (ARR)?",
      "required": true,
      "currencies": ["USD", "CAD", "GBP", "EUR", "AUD"],
      "hypotheses": []
    },
    {
      "id": "profile.arr_confidence",
      "section": "profile",
      "type": "select",
      "label": "How accurate is that number?",
      "required": true,
      "options": [
        { "value": "exact", "label": "Exact" },
        { "value": "approximate", "label": "Approximate" },
        { "value": "rough", "label": "Very rough estimate" }
      ],
      "hypotheses": []
    },
    {
      "id": "profile.customer_count",
      "section": "profile",
      "type": "number",
      "label": "About how many paying customers?",
      "required": true,
      "min": 1,
      "hypotheses": []
    },
    {
      "id": "pricing.models",
      "section": "pricing",
      "type": "multiselect",
      "label": "How do you charge? (select all that apply)",
      "required": true,
      "options": [
        { "value": "flat", "label": "Flat subscription" },
        { "value": "per_seat", "label": "Per seat" },
        { "value": "usage", "label": "Usage-based" },
        { "value": "tiered", "label": "Tiered" },
        { "value": "custom_enterprise", "label": "Custom enterprise deals" },
        { "value": "addons", "label": "Add-ons" },
        { "value": "bundles", "label": "Bundles" },
        { "value": "minimum_commit", "label": "Minimum spend commitments" },
        { "value": "hybrid", "label": "Mix of pricing types" }
      ],
      "hypotheses": ["H5", "H10", "H11"]
    },
    {
      "id": "usage.rating",
      "section": "usage",
      "type": "select",
      "label": "How is usage priced?",
      "required": true,
      "visibility": { "when": "pricing.models", "contains": "usage" },
      "options": [
        { "value": "simple", "label": "Simple unit price" },
        { "value": "tiered", "label": "Price changes at volume tiers" },
        { "value": "commit_overage", "label": "Prepaid commit with overage charges" },
        { "value": "custom", "label": "Custom enterprise rate" }
      ],
      "hypotheses": ["H11"]
    },
    {
      "id": "usage.reconciliation",
      "section": "usage",
      "type": "select",
      "label": "How do you verify usage before invoicing?",
      "required": true,
      "visibility": { "when": "pricing.models", "contains": "usage" },
      "options": [
        { "value": "automated", "label": "Fully automated" },
        { "value": "partial", "label": "Partially automated" },
        { "value": "manual", "label": "Manual" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H11"]
    },
    {
      "id": "seats.reconciliation",
      "section": "seats",
      "type": "select",
      "label": "How do you track seat changes before billing?",
      "required": true,
      "visibility": { "when": "pricing.models", "contains": "per_seat" },
      "options": [
        { "value": "automatic", "label": "Automatic" },
        { "value": "manual", "label": "Manual" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H10"]
    },
    {
      "id": "product.billable_count",
      "section": "product",
      "type": "select",
      "label": "How many separate products or plans do you sell?",
      "required": true,
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3_5", "label": "3 to 5" },
        { "value": "6_10", "label": "6 to 10" },
        { "value": "11_25", "label": "11 to 25" },
        { "value": "25_plus", "label": "25+" }
      ],
      "hypotheses": ["H5", "H7", "H8", "H9"]
    },
    {
      "id": "product.independent_catalogs",
      "section": "product",
      "type": "select",
      "label": "Does each product have its own price list?",
      "required": true,
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" },
        { "value": "some", "label": "Some" }
      ],
      "hypotheses": ["H5", "H6"]
    },
    {
      "id": "product.addons",
      "section": "product",
      "type": "boolean",
      "label": "Do you sell optional add-on products?",
      "required": true,
      "hypotheses": ["H8", "H9"]
    },
    {
      "id": "contracts.negotiated_arr_pct",
      "section": "contracts",
      "type": "select",
      "label": "What share of revenue comes from custom-negotiated deals?",
      "required": true,
      "options": [
        { "value": "0", "label": "0%" },
        { "value": "1_25", "label": "1 to 25%" },
        { "value": "26_50", "label": "26 to 50%" },
        { "value": "51_75", "label": "51 to 75%" },
        { "value": "76_100", "label": "76 to 100%" }
      ],
      "hypotheses": ["H12", "H13", "H18"]
    },
    {
      "id": "contracts.grandfathering",
      "section": "contracts",
      "type": "select",
      "label": "When you raise prices, do existing customers keep their old rate?",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "frequently", "label": "Frequently" },
        { "value": "very_frequently", "label": "Very frequently" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H1", "H2"]
    },
    {
      "id": "contracts.renewal_increases",
      "section": "contracts",
      "type": "select",
      "label": "Are price increases applied automatically at renewal?",
      "required": true,
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" },
        { "value": "partially", "label": "Partially" },
        { "value": "manual", "label": "Manually" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H2"]
    },
    {
      "id": "discounts.frequency",
      "section": "discounts",
      "type": "select",
      "label": "How often do you offer negotiated discounts?",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rare", "label": "Rare" },
        { "value": "occasional", "label": "Occasional" },
        { "value": "common", "label": "Common" },
        { "value": "nearly_all", "label": "Nearly every enterprise deal" }
      ],
      "hypotheses": ["H3", "H4"],
      "branches": {
        "rare": ["discounts.auto_expiry_removal"],
        "occasional": ["discounts.auto_expiry_removal"],
        "common": ["discounts.auto_expiry_removal"],
        "nearly_all": ["discounts.auto_expiry_removal"]
      }
    },
    {
      "id": "discounts.auto_expiry_removal",
      "section": "discounts",
      "type": "select",
      "label": "When a time-limited discount ends, is it removed from billing automatically?",
      "required": true,
      "visibility": { "when": "discounts.frequency", "not_equals": "never" },
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "usually", "label": "Usually" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "never", "label": "Never" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H3", "H4"]
    },
    {
      "id": "discounts.expiry_confidence",
      "section": "discounts",
      "type": "scale",
      "label": "How confident are you that discounts end on schedule?",
      "required": true,
      "min": 1,
      "max": 5,
      "hypotheses": ["H3", "H4"]
    },
    {
      "id": "discounts.stacking_policy",
      "section": "discounts",
      "type": "select",
      "label": "Can more than one discount apply to the same subscription?",
      "required": true,
      "options": [
        { "value": "never", "label": "No, never" },
        { "value": "single", "label": "Only one discount allowed" },
        { "value": "limited", "label": "Sometimes, with approval" },
        { "value": "allowed", "label": "Yes, without clear rules" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H3", "H4"]
    },
    {
      "id": "changes.pricing_changes_24mo",
      "section": "changes",
      "type": "select",
      "label": "How many company-wide pricing changes in the last 2 years?",
      "required": true,
      "options": [
        { "value": "0", "label": "None" },
        { "value": "1", "label": "1 change" },
        { "value": "2_3", "label": "2 to 3" },
        { "value": "4_5", "label": "4 to 5" },
        { "value": "6_plus", "label": "6+" }
      ],
      "hypotheses": ["H1", "H2", "H6", "H17"]
    },
    {
      "id": "changes.migration_method",
      "section": "changes",
      "type": "select",
      "label": "When prices changed, how were existing customers moved to new rates?",
      "required": true,
      "options": [
        { "value": "automatic", "label": "Automatically" },
        { "value": "renewal", "label": "At renewal" },
        { "value": "manual", "label": "Manually" },
        { "value": "case_by_case", "label": "Case-by-case" },
        { "value": "not_standardized", "label": "Not standardized" },
        { "value": "unknown", "label": "Unknown" },
        { "value": "na", "label": "No pricing changes" }
      ],
      "hypotheses": ["H1", "H6", "H17"]
    },
    {
      "id": "systems.billing_system_count",
      "section": "systems",
      "type": "select",
      "label": "How many systems handle billing today?",
      "required": true,
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3_plus", "label": "3+" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H14", "H16"]
    },
    {
      "id": "systems.primary_platform",
      "section": "systems",
      "type": "select",
      "label": "What is your main billing platform?",
      "required": true,
      "options": [
        { "value": "stripe", "label": "Stripe" },
        { "value": "chargebee", "label": "Chargebee" },
        { "value": "zuora", "label": "Zuora" },
        { "value": "maxio", "label": "Maxio" },
        { "value": "recurly", "label": "Recurly" },
        { "value": "custom", "label": "Custom" },
        { "value": "erp", "label": "ERP" },
        { "value": "multiple", "label": "Multiple" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": []
    },
    {
      "id": "operations.manual_override_frequency",
      "section": "operations",
      "type": "select",
      "label": "How often does someone manually change a customer's bill?",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "frequently", "label": "Frequently" },
        { "value": "very_frequently", "label": "Very frequently" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H16"]
    },
    {
      "id": "operations.unticketed_adjustments",
      "section": "operations",
      "type": "select",
      "label": "How often are billing changes made without a ticket or approval?",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "often", "label": "Often" },
        { "value": "very_often", "label": "Very often" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H16"]
    },
    {
      "id": "operations.credit_memo_process",
      "section": "operations",
      "type": "select",
      "label": "How are credits and refunds issued?",
      "required": true,
      "options": [
        { "value": "automated", "label": "Automated in billing system" },
        { "value": "reviewed", "label": "Created with finance review" },
        { "value": "manual", "label": "Manual spreadsheet or ad hoc" },
        { "value": "ad_hoc", "label": "No consistent process" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H4"]
    },
    {
      "id": "operations.churn_billing_cutoff",
      "section": "operations",
      "type": "select",
      "label": "When a customer churns, how quickly is billing stopped?",
      "required": true,
      "options": [
        { "value": "immediate", "label": "Immediately automated" },
        { "value": "same_day", "label": "Same business day" },
        { "value": "within_week", "label": "Within a week" },
        { "value": "manual", "label": "Manual cleanup, often delayed" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H13"]
    },
    {
      "id": "quote_to_bill.commercial_truth",
      "section": "quote_to_bill",
      "type": "select",
      "label": "Where is the final sold price recorded before invoicing?",
      "required": true,
      "options": [
        { "value": "crm", "label": "CRM (Salesforce, HubSpot, etc.)" },
        { "value": "billing", "label": "Billing system" },
        { "value": "cpq", "label": "Quoting tool (CPQ)" },
        { "value": "contracts", "label": "Contracts" },
        { "value": "spreadsheet", "label": "Spreadsheet" },
        { "value": "multiple", "label": "Multiple systems" },
        { "value": "undefined", "label": "Not clearly defined" }
      ],
      "hypotheses": ["H12", "H13"]
    },
    {
      "id": "quote_to_bill.quote_automation",
      "section": "quote_to_bill",
      "type": "select",
      "label": "How much of the path from signed deal to invoice is automated?",
      "required": true,
      "options": [
        { "value": "fully", "label": "Fully automated" },
        { "value": "mostly", "label": "Mostly automated" },
        { "value": "partial", "label": "Partially automated" },
        { "value": "mostly_manual", "label": "Mostly manual" },
        { "value": "manual", "label": "Manual" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H12", "H13"]
    },
    {
      "id": "quote_to_bill.finance_sales_disagreement",
      "section": "quote_to_bill",
      "type": "select",
      "label": "How often do finance and sales disagree on what was sold?",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "often", "label": "Often" },
        { "value": "very_often", "label": "Very often" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H12", "H13"]
    },
    {
      "id": "migrations.migrated_36mo",
      "section": "migrations",
      "type": "boolean",
      "label": "Have you migrated billing systems in the last 36 months?",
      "required": true,
      "hypotheses": ["H14"],
      "branches": {
        "true": ["migrations.reconciliation", "migrations.parallel_systems"]
      }
    },
    {
      "id": "migrations.reconciliation",
      "section": "migrations",
      "type": "select",
      "label": "Did you verify billing data after a system migration?",
      "required": true,
      "visibility": { "when": "migrations.migrated_36mo", "equals": true },
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" },
        { "value": "partial", "label": "Partially" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H14"]
    },
    {
      "id": "migrations.parallel_systems",
      "section": "migrations",
      "type": "boolean",
      "label": "Did you run parallel billing systems during migration?",
      "required": true,
      "visibility": { "when": "migrations.migrated_36mo", "equals": true },
      "hypotheses": ["H14"]
    },
    {
      "id": "international.multi_currency",
      "section": "international",
      "type": "boolean",
      "label": "Do you bill in multiple currencies?",
      "required": true,
      "hypotheses": ["H15"],
      "branches": {
        "true": ["international.currency_count"]
      }
    },
    {
      "id": "international.currency_count",
      "section": "international",
      "type": "select",
      "label": "How many currencies do you bill in?",
      "required": true,
      "visibility": { "when": "international.multi_currency", "equals": true },
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3_5", "label": "3 to 5" },
        { "value": "6_plus", "label": "6+" }
      ],
      "hypotheses": ["H15"]
    },
    {
      "id": "controls.billing_owner",
      "section": "controls",
      "type": "boolean",
      "label": "Is there someone clearly responsible for billing?",
      "required": true,
      "hypotheses": []
    },
    {
      "id": "controls.monthly_reconciliation",
      "section": "controls",
      "type": "select",
      "label": "How often do you compare invoices to signed contracts?",
      "required": true,
      "options": [
        { "value": "monthly", "label": "Every month" },
        { "value": "quarterly", "label": "Quarterly" },
        { "value": "occasionally", "label": "Occasionally" },
        { "value": "never", "label": "Never" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": []
    },
    {
      "id": "controls.billing_qa",
      "section": "controls",
      "type": "select",
      "label": "After a pricing change, do you test billing before invoices go out?",
      "required": true,
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "usually", "label": "Usually" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "never", "label": "Never" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": []
    },
    {
      "id": "controls.invoice_price_qa",
      "section": "controls",
      "type": "select",
      "label": "Before sending invoices, do you check amounts match what customers should pay?",
      "required": true,
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "usually", "label": "Usually" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "never", "label": "Never" },
        { "value": "unknown", "label": "Unknown" }
      ],
      "hypotheses": ["H16"]
    },
    {
      "id": "confidence.billing_confidence",
      "section": "confidence",
      "type": "scale",
      "label": "Overall, how confident are you that every customer is billed at their agreed price?",
      "required": true,
      "min": 1,
      "max": 5,
      "hypotheses": []
    }
  ]
}
